<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MDP Generator</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
<div class="wrapper">

  <header>
    <div class="header-top">
      <span class="site-title">mdp-gen</span>
      <span class="site-tag">v0.3</span>
    </div>
    <p class="site-desc">All-atom molecular dynamics parameter file generator. Configure your system and download ready-to-use <code style="color:var(--accent);font-family:var(--mono)">.mdp</code> files for GROMACS.</p>
  </header>

  <div class="layout">

    <!-- Panel 1: System & Force Field -->
    <div class="panel">
      <div class="panel-header"><span class="dot"></span>system &amp; force field</div>
      <div class="panel-body">
        <div class="field">
          <label>system type</label>
          <select id="system">
            <option value="DNA">DNA</option>
            <option value="Protein">Protein</option>
            <option value="RNA">RNA</option>
            <option value="Lipid bilayer">Lipid bilayer</option>
            <option value="Protein-DNA complex">Protein-DNA complex</option>
            <option value="Protein-RNA complex">Protein-RNA complex</option>
            <option value="Small molecule">Small molecule</option>
          </select>
        </div>
        <div class="field">
          <label>force field</label>
          <select id="ff" onchange="applyFFDefaults()">
            <option value="BSC1">BSC1</option>
            <option value="BSC0">BSC0</option>
            <option value="OL21">OL21</option>
            <option value="OL15">OL15</option>
            <option value="CHARMM36m">CHARMM36m</option>
            <option value="AMBER99SB-ILDN">AMBER99SB-ILDN</option>
            <option value="AMBER14SB">AMBER14SB</option>
            <option value="GROMOS96-54a7">GROMOS96 54a7</option>
            <option value="OPLS-AA">OPLS-AA</option>
          </select>
          <div class="ff-note" id="ff-note"></div>
        </div>
        <div class="field">
          <label>water model</label>
          <select id="water">
            <option value="TIP3P">TIP3P</option>
            <option value="TIP4P">TIP4P</option>
            <option value="TIP4P/2005">TIP4P/2005</option>
            <option value="TIP5P">TIP5P</option>
            <option value="SPC">SPC</option>
            <option value="SPC/E">SPC/E</option>
            <option value="OPC">OPC</option>
            <option value="OPC3">OPC3</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Panel 2: Coupling -->
    <div class="panel">
      <div class="panel-header"><span class="dot"></span>coupling</div>
      <div class="panel-body">
        <div class="field">
          <div class="toggle-row">
            <label>pressure coupling (pcoupl)</label>
            <div class="yn-btns">
              <button class="yn-btn active" id="pc-yes" onclick="toggleSection('pcoupl',true)">yes</button>
              <button class="yn-btn"        id="pc-no"  onclick="toggleSection('pcoupl',false)">no</button>
            </div>
          </div>
        </div>
        <div class="sub-fields" id="pcoupl-sub">
          <div class="field">
            <label>pcoupl algorithm</label>
            <select id="pcoupl">
              <option value="Automated">Automated (per forcefield)</option>
              <option value="C-rescale">C-rescale</option>
              <option value="Parrinello-Rahman">Parrinello-Rahman</option>
              <option value="Berendsen">Berendsen</option>
              <option value="MTTK">MTTK</option>
            </select>
          </div>
          <div class="field-row">
            <div class="field"><label>ref pressure (bar)</label><input type="number" id="pres" value="1.0" min="0" max="1000" step="0.1"/></div>
            <div class="field"><label>tau_p (ps)</label><input type="number" id="taup" value="2.0" min="0" step="0.5"/></div>
          </div>
          <div class="field"><label>compressibility (bar^-1)</label><input type="text" id="compress" value="4.5e-5"/></div>
        </div>

        <div class="field">
          <div class="toggle-row">
            <label>temperature coupling (tcoupl)</label>
            <div class="yn-btns">
              <button class="yn-btn active" id="tc-yes" onclick="toggleSection('tcoupl',true)">yes</button>
              <button class="yn-btn"        id="tc-no"  onclick="toggleSection('tcoupl',false)">no</button>
            </div>
          </div>
        </div>
        <div class="sub-fields" id="tcoupl-sub">
          <div class="field">
            <label>tcoupl algorithm</label>
            <select id="tcoupl">
              <option value="Automated">Automated (per forcefield)</option>
              <option value="V-rescale">V-rescale</option>
              <option value="Nose-Hoover">Nose-Hoover</option>
              <option value="Berendsen">Berendsen</option>
              <option value="andersen">Andersen</option>
            </select>
          </div>
          <div class="field-row">
            <div class="field"><label>ref temperature (K)</label><input type="number" id="temp" value="300" min="0" max="1000" step="10"/></div>
            <div class="field"><label>tau_t (ps)</label><input type="number" id="taut" value="0.1" min="0" step="0.05"/></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Run lengths -->
    <div class="panel">
      <div class="panel-header"><span class="dot"></span>run lengths</div>
      <div class="panel-body">
        <div class="field"><label>energy minimization (steps)</label><input type="number" id="em" value="50000" min="0" step="5000"/></div>
        <div class="field"><label>equilibration (ns)</label><input type="number" id="equil" value="10" min="0" step="1"/></div>
        <div class="field"><label>production run (ns)</label><input type="number" id="prod" value="100" min="0" step="10"/></div>
        <div class="field">
          <label>timestep (fs)</label>
          <select id="dt">
            <option value="0.002">2 fs (default)</option>
            <option value="0.001">1 fs (conservative)</option>
            <option value="0.004">4 fs (h-mass repartitioning)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Panel 4: Electrostatics & Constraints -->
    <div class="panel">
      <div class="panel-header"><span class="dot"></span>electrostatics &amp; constraints</div>
      <div class="panel-body">
        <div class="field">
          <label>coulomb type</label>
          <select id="coulomb">
            <option value="PME">PME (recommended)</option>
            <option value="Reaction-Field">Reaction-Field</option>
            <option value="Cut-off">Cut-off</option>
          </select>
        </div>
        <div class="field">
          <div class="toggle-row">
            <label>specify rcoulomb cutoff</label>
            <div class="yn-btns">
              <button class="yn-btn active" id="rc-yes" onclick="toggleSection('rcoulomb',true)">yes</button>
              <button class="yn-btn"        id="rc-no"  onclick="toggleSection('rcoulomb',false)">no</button>
            </div>
          </div>
        </div>
        <div class="sub-fields" id="rcoulomb-sub">
          <div class="field"><label>rcoulomb (nm)</label><input type="number" id="rcoul" value="1.2" min="0.8" max="2.0" step="0.1"/></div>
        </div>
        <div class="field">
          <div class="toggle-row">
            <label>specify rvdw cutoff</label>
            <div class="yn-btns">
              <button class="yn-btn active" id="rv-yes" onclick="toggleSection('rvdw',true)">yes</button>
              <button class="yn-btn"        id="rv-no"  onclick="toggleSection('rvdw',false)">no</button>
            </div>
          </div>
        </div>
        <div class="sub-fields" id="rvdw-sub">
          <div class="field"><label>rvdw (nm)</label><input type="number" id="rvdw" value="1.2" min="0.8" max="2.0" step="0.1"/></div>
        </div>
        <div class="field">
          <label>constraints</label>
          <select id="constraints">
            <option value="h-bonds">h-bonds</option>
            <option value="all-bonds">all-bonds</option>
            <option value="h-angles">h-angles</option>
            <option value="none">none</option>
          </select>
        </div>
        <div class="field">
          <label>pbc (periodic boundary)</label>
          <select id="pbc">
            <option value="xyz">xyz (full 3D)</option>
            <option value="xy">xy only (slab)</option>
            <option value="no">no</option>
          </select>
        </div>
        <button class="btn-generate" onclick="generate()">generate .mdp files</button>
      </div>
    </div>

    <!-- Output -->
    <div class="panel output-panel">
      <div class="output-toolbar">
        <div class="output-toolbar-left"><span class="dot"></span>output</div>
        <div class="output-toolbar-right">
          <button class="btn-copy" id="copybtn" onclick="copyActive()">copy</button>
          <button class="btn-dl"                onclick="downloadActive()">download</button>
        </div>
      </div>
      <div class="tab-bar">
        <button class="tab-btn" data-tab="ions" onclick="switchTab('ions')">ions.mdp</button>
        <button class="tab-btn" data-tab="em"   onclick="switchTab('em')">em.mdp</button>
        <button class="tab-btn" data-tab="nvt"  onclick="switchTab('nvt')">nvt.mdp</button>
        <button class="tab-btn" data-tab="npt"  onclick="switchTab('npt')">npt.mdp</button>
        <button class="tab-btn active" data-tab="md" onclick="switchTab('md')">md.mdp</button>
      </div>

      <div id="pane-ions" class="tab-pane">
        <div class="output-code"><span class="placeholder">; Click "generate .mdp files" to populate all tabs</span></div>
      </div>
      <div id="pane-em" class="tab-pane">
        <div class="output-code"><span class="placeholder">; Click "generate .mdp files" to populate all tabs</span></div>
      </div>
      <div id="pane-nvt" class="tab-pane">
        <div class="output-code"><span class="placeholder">; Click "generate .mdp files" to populate all tabs</span></div>
      </div>
      <div id="pane-npt" class="tab-pane">
        <div class="output-code"><span class="placeholder">; Click "generate .mdp files" to populate all tabs</span></div>
      </div>
      <div id="pane-md" class="tab-pane active">
        <div class="output-code"><span class="placeholder">; Click "generate .mdp files" to populate all tabs</span></div>
      </div>
    </div>

  </div>

  <footer>
    <span>mdp-gen &mdash; GROMACS all-atom MD parameter generator</span>
    <span>github pages &mdash; open source</span>
  </footer>
</div>

<script src="parameters.js"></script>
<script src="app.js"></script>
</body>
</html>
